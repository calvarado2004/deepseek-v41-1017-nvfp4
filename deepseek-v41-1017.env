# /etc/spark-llm/profiles/deepseek-v41-1017.env, read by
# spark-llm-deepseek-v41-1017@.service on all four ranks. Unset keys take the
# launcher's defaults (bin/launch-ring4).
DSV41K_IMAGE=spark-dsv41k:0cbac6c-p10
# Space-separated: the image is built on each node, so each has its own id.
# Fill in after scripts/build-image.sh prints them; empty skips the check.
DSV41K_IMAGE_ID=
DSV41K_MODEL_DIR=/srv/spark-llm/models/deepseek-v41-1017-nvfp4
DSV41K_MODEL_REVISION=5be99cd15675589fb6693d0a8651e413bcb9a396
DSV41K_SERVED_MODEL_NAME=DeepSeek-V4.1-Flash-1017-NVFP4
# First boot target; ondigo ran 262144 only. Lower it if the needle ladder fails.
DSV41K_MAX_MODEL_LEN=1048576
# 0.80 left 2.18 GiB of KV with vision on (1M needs 3.66 GiB; boot 2026-10-19).
DSV41K_GPU_MEM_UTIL=0.84
DSV41K_MAX_NUM_SEQS=16
DSV41K_MAX_NUM_BATCHED_TOKENS=8192
DSV41K_SPEC_TOKENS=7
DSV41K_DRAFT_SAMPLE=probabilistic
DSV41K_REJECTION=block
DSV41K_ADAPTIVE_VERIFY=false
DSV41K_MAX_IMAGES=32
DSV41K_VIDEO_FPS=1.0
DSV41K_VIDEO_MAX_FRAMES=16
DSV41K_LANGUAGE_MODEL_ONLY=0
DSV41K_NCCL_DEBUG=WARN
# ondigo-winder's switchless 4-HCA NCCL (scripts/build-nccl-4hca.sh): prefill
# 32K +15%, decode step at 1 stream -6% against stock NCCL. Empty = stock.
DSV41K_NCCL_LIB=/opt/spark-llm/nccl-4hca
# MoE kernel; empty = vLLM auto (flashinfer_cutlass), the only one that works
# here (b12x: no SwiGLU clamp; cutedsl: not GB10; cutlass: not MXFP4 drafter).
DSV41K_MOE_BACKEND=
# arx RDMA all-reduce (kindling, built on the Sparks by scripts/build-arx-overlay.sh):
# decode step -3%, KV pool 2.04M -> 2.53M tokens, count100 exact. 0 = NCCL only.
# Off here: scripts/build-arx-overlay.sh needs a kindling checkout and image (README).
DSV41K_ARX=0
# Draft attends to the last 32K context tokens (patch 0006, vllm#61261).
DSV41K_DRAFT_CONTEXT_WINDOW=32768
# Indexer K cache in MXFP4 instead of FP8 (vLLM V4.1 recipe; sm_120 family allowed).
DSV41K_ATTENTION_CONFIG='{"indexer_kv_dtype":"mxfp4"}'
# Weight load: auto, or instanttensor (patch 0010; experimental, not yet measured
# on this card). With instanttensor, pin the KV pool in bytes:
DSV41K_LOAD_FORMAT=auto
#DSV41K_KV_CACHE_MEMORY_BYTES=8589934592
