# Your four nodes, edit before anything else. Every script sources this file.
#
# SSH names of the four Sparks in RING (rank) order: rank 0 is the head, and
# each rank is cabled to rank-1 and rank+1 (rank 3 back to rank 0).
SPARK_HOSTS="spark-0 spark-1 spark-2 spark-3"
# The head (rank 0) as the scripts reach it over SSH.
SPARK_HEAD="spark-0"
# The account that owns /opt/spark-llm and runs the containers on every node.
SPARK_USER="spark"
# Ring addresses of ranks 1, 2, 3 as rank 0 sees them (bin/launch-ring4 holds
# the full per-rank table: addresses, netdevs, and which port faces which peer).
SPARK_RING_PEERS="192.168.100.11 192.168.104.13 192.168.101.12"
